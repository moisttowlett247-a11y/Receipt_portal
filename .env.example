# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Master Admin PIN for GitHub Pages/local web console (defaults to interactive setup in UI)
VITE_ADMIN_PIN=

# QuickBooks Online OAuth 2.0 Central Token Broker (Production & Sandbox)
# Intuit Client Secrets are kept strictly on the web server to comply with Intuit App Store guidelines.
# 1. REQUIRED FROM INTUIT DEVELOPER PORTAL (Keys & credentials):
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=production

# 2. OPTIONAL (Auto-detected if left blank):
# Defaults automatically to https://<your-app-domain>/api/qbo/callback
QBO_REDIRECT_URI=

# 3. OPTIONAL FROM INTUIT DEVELOPER PORTAL (Webhooks menu):
# Leave blank unless you set up Webhooks under Intuit App -> Production -> Webhooks.
# Intuit generates this token ONLY after you save your Webhook URL and click "Show Token".
QBO_WEBHOOK_VERIFIER_TOKEN=

# 4. OPTIONAL INTERNAL SECRET (Not from Intuit!):
# Master key used by our server to encrypt tokens with AES-256-GCM.
# Leave blank to use the secure built-in salt automatically, or type any random 32+ character string.
QBO_ENCRYPTION_KEY=
